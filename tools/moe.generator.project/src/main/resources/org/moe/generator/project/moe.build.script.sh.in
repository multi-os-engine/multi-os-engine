set -e

export MOE_BUILD_SOURCE_SET="${_PLACEHOLDER_MOE_TARGET_SOURCESET_NAME}"
export MOE_BUILD_MODE="$(echo $CONFIGURATION | tr '[:upper:]' '[:lower:]')"

# Check project directory
if [ ! -d "$MOE_PROJECT_DIR" ]; then
    echo "$0:$LINENO:1: error: 'MOE_PROJECT_DIR' doesn't point to a directory!"; exit 1;
fi
cd "$MOE_PROJECT_DIR"

# Export JAVA_HOME
if [ -z "$JAVA_HOME" ]; then
    if [ -z "$MOE_JAVA_VERSION_OVERRIDE" ]; then
        export JAVA_HOME=$(/usr/libexec/java_home)
    else
        export JAVA_HOME=$(/usr/libexec/java_home -v "$MOE_JAVA_VERSION_OVERRIDE")
    fi
fi
echo $JAVA_HOME

# Utility function for finding the Gradle implementation
function findGradle {
    CD="$PWD"
    while [ "$CD" != "" ]; do
        echo "Looking for gradlew in $CD"
        if [ -x "$CD/gradlew" ]; then
            GRADLE_EXEC=$CD/gradlew
            return 0
        fi
        CD="${CD%/*}"
    done

    echo "Checking with 'which'"
    GRADLE_EXEC=$(which 'gradle')

    if [ "$GRADLE_EXEC" = "" ]; then
        echo "Failed to locate 'gradle' executable!"
        exit 1
    fi
}

# Build project with Gradle
if [ -z "$MOE_GRADLE_EXTERNAL_BUILD" ]; then
    findGradle
    "$GRADLE_EXEC" --no-daemon moeXcodeInternal -s
fi

# Check output directory
if [ ! -d "${MOE_PROJECT_BUILD_DIR}" ]; then
    echo "$0:$LINENO:1: error: 'MOE_PROJECT_BUILD_DIR' doesn't point to a directory!"; exit 1;
fi

# Copy some resources
mkdir -p "${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}"
cp "${MOE_PROJECT_BUILD_DIR}/moe/${MOE_BUILD_SOURCE_SET}/startup-provider/${MOE_BUILD_MODE}/preregister.txt" "${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/"
cp "${MOE_PROJECT_BUILD_DIR}/moe/${MOE_BUILD_SOURCE_SET}/startup-provider/${MOE_BUILD_MODE}/objc-bindings.txt" "${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/"
if [ "${MOE_BUILD_SOURCE_SET}" == "test" ]; then
    cp "${MOE_PROJECT_BUILD_DIR}/moe/${MOE_BUILD_SOURCE_SET}/test-provider/${MOE_BUILD_MODE}/classlist.txt" "${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/"
fi

copy_and_sign_framework() {
    local framework_path="$1"
    local framework_name="$2"

    if [ -z "$framework_path" ] || [ -z "$framework_name" ]; then
        echo "Error: Usage: copy_and_sign_framework <framework_path> <framework_name>"
        return 1
    fi

    # Copy framework excluding version control and unnecessary directories
    rsync -av \
        --filter "- CVS/" \
        --filter "- .svn/" \
        --filter "- .git/" \
        --filter "- .hg/" \
        --filter "- Headers" \
        --filter "- PrivateHeaders" \
        --filter "- Modules" \
        "${framework_path}/${framework_name}.framework" \
        "${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}/"

    # Thin the framework binary for specific architecture if needed
    if [ "${ARCHS}" == "arm64" ] || [ "${ARCHS}" == "x86_64" ]; then
        if [ "${PLATFORM_NAME}" == "iphonesimulator" ]; then
            lipo -thin "${ARCHS}" \
                -output "${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}/${framework_name}.framework/${framework_name}" \
                "${framework_path}/${framework_name}.framework/${framework_name}"
        fi
    fi

    # Code sign the framework if required
    if [ -n "${EXPANDED_CODE_SIGN_IDENTITY}" ] && \
       [ "${CODE_SIGNING_REQUIRED}" != "NO" ] && \
       [ "${CODE_SIGNING_ALLOWED}" != "NO" ]; then
        /usr/bin/codesign --force \
            --sign "$EXPANDED_CODE_SIGN_IDENTITY" \
            $OTHER_CODE_SIGN_FLAGS \
            --preserve-metadata=identifier,entitlements \
            "${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}/${framework_name}.framework"
    fi
}

if [ "${CONFIGURATION}" == "Debug" ]; then
    copy_and_sign_framework "${MOE_FRAMEWORK_PATH}" "svmjdwp"
    for arch in ${ARCHS}; do
        cp "${MOE_PROJECT_BUILD_DIR}/moe/${MOE_BUILD_SOURCE_SET}/xcode/${CONFIGURATION}${EFFECTIVE_PLATFORM_NAME}/jdwp_${arch}.metadata" "${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/jdwp_${arch}.metadata"
    done
fi
